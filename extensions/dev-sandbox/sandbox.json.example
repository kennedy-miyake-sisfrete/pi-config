{
  "enabled": true,
  "internet": {
    "enabled": true
  },
  "_warning_docker_sock": "NUNCA monte /var/run/docker.sock a menos que você entenda o risco: qualquer processo no sandbox pode usar o socket para ganhar acesso root ao host (ex: docker run -v /:/host --privileged).",
  "filesystem": {
    "extraWritable": [],
    "extraReadonly": [
      "/mnt/dados"
    ],
    "denyPaths": [
      "/sbin",
      "/usr/sbin",
      "/root"
    ],
    "cacheDirs": {
      "npm": "",
      "pip": ""
    }
  },
  "ssh": {
    "mode": "agent"
  }
}
